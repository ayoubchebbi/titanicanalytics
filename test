public class WorkDay {
    private List<SObject> items = new List<SObject>();
    private Long workingMinutes = 0;

    public void addItem(SObject item) {
        this.items.add(item);
        this.workingMinutes += getDurationMinutes(item);
    }

    public List<SObject> getItems() { return this.items; }
    public Long getWorkingMinutes() { return this.workingMinutes; }

    private Long getDurationMinutes(SObject item) {
        Object startVal = item.get('StartTime');
        Object endVal   = item.get('EndTime');
        if (startVal == null || endVal == null) return 0;

        // Shift, ServiceAppointment... (Datetime)
        if (startVal instanceof Datetime) {
            return (((Datetime) endVal).getTime() - ((Datetime) startVal).getTime()) / 60000;
        }
        // TimeSlot (Time)
        if (startVal instanceof Time) {
            Time s = (Time) startVal;
            Time e = (Time) endVal;
            Long debut = s.hour() * 60 + s.minute();
            Long fin   = e.hour() * 60 + e.minute();
            if (fin <= debut) fin += 24 * 60; // créneau qui finit à minuit
            return fin - debut;
        }
        return 0;
    }
}
